# Server Configuration
PORT=5009
DATA_DIR=data
DB_PATH=

# Network Configuration
DEFAULT_NETWORK=ethereum
ENABLE_TESTNETS=false

# RPC Endpoints
ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/demo
BSC_RPC=https://bsc-dataseed.binance.org/
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# Kosongkan SOLANA_RPC agar otomatis diturunkan dari SOLANA_WSS.
SOLANA_RPC=
POLYGON_RPC=https://polygon-rpc.com

# WebSocket Endpoints (khusus watcher saldo real-time, opsional)
# Tidak ada default di source. Isi di sini atau lewat tabel rpc_configs.
# Contoh endpoint gratis (PublicNode):
ETHEREUM_WSS=
BSC_WSS=
ARBITRUM_WSS=
ROBINHOOD_WSS=
SOLANA_WSS=

# Watcher saldo real-time
WS_WATCHER_ENABLED=true
WS_DEBOUNCE=4s
WS_REFRESH=30s

# Security
ENCRYPTION_KEY=your-secure-encryption-key-here

# Wallet identity (BIP39 seed phrase, 12 kata)
# Isi manual. JANGAN commit file .env asli.
WALLET_MNEMONIC=

# Backup Configuration
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# Development
DEBUG=true

# Testnet Endpoints (optional)
ETHEREUM_SEPOLIA_RPC=https://sepolia.infura.io/v3/your-project-id
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
SOLANA_DEVNET_RPC=https://api.devnet.solana.com